{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Automation Agent",
  "version": "0.1.0",
  "identifier": "com.fmq.automationagent",
  "build": {
    "devUrl": "http://127.0.0.1:8000/",
    "frontendDist": "http://127.0.0.1:8000/"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Automation Agent",
        "url": "http://127.0.0.1:8000/",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "DeveloperTool",
    "shortDescription": "Automation Agent 桌面工作台",
    "longDescription": "通过本机 Agent 服务运行连续对话、查看工具事件并处理逐次授权。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ]
  }
}

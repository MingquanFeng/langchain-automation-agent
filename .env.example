# ===== 模型配置 =====
# 必填：模型供应商的 API key
LLM_API_KEY=

# 模型名与供应商。provider 必填，不靠自动推断（有些模型名推断会报错）：
#   deepseek / openai / anthropic / openrouter / ollama / ...
# 每个 provider 要装对应的 langchain-xxx 包。
# 换模型的其余注意事项见 CLAUDE.md 的「换模型须知」。
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat

# 自定义端点（走中转/代理时填），留空则用供应商官方地址
LLM_BASE_URL=

LLM_TEMPERATURE=0.3

# ===== LangSmith 追踪（可选）=====
# 看每次 invoke 的完整 trace：每一步的输入输出、耗时、token 用量。
# 调试 agent 最快的利器 —— 代码里 print 的信息远没有 trace 全。
#
# 开启方法：
#   1. 到 https://smith.langchain.com 申请 API key（免费额度够学习用）
#   2. 把下面 TRACING 改成 true
#
# 注意：
#   - 值必须是精确的小写 true，写成 1 或 True 都不生效（框架做的是精确匹配）
#   - 只能在这里改：项目的 .env 会盖掉 shell 里的同名环境变量
#   - 没填 key 就开着的话，每次调用都会刷一条 401 报错。
#     不影响运行，但很吵 —— 所以默认关
#   - 追踪会把提示词与模型输出发到 LangSmith 云端，敏感内容先想清楚
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=automation-agent

# ===== 运行时 =====
API_HOST=127.0.0.1
API_PORT=8000

# 定时任务总开关，0 表示只起服务不跑定时任务
SCHEDULER_ENABLED=1
SCHEDULER_TIMEZONE=Asia/Shanghai

# ===== 记忆 =====
# sqlite 落盘 / memory 仅内存
MEMORY_BACKEND=sqlite

# ===== 通知出口 =====
# terminal 只输出到终端 / webhook 发到群里
NOTIFY_CHANNEL=terminal
# 飞书/钉钉/企业微信群机器人地址，留空则只用终端
NOTIFY_WEBHOOK=

# ===== 隐私 =====
# PII 脱敏开关。1 启用，0 关闭。默认启用。
#
# 启用后，用户指令与工具结果里的邮箱、信用卡、手机号、身份证号
# 会被替换成 [REDACTED_EMAIL] 这样的占位符再发给模型
# （工具结果里读到的文件内容也走这条）。
#
# 什么时候该关：
# 想让 agent 处理一份本来就该被它看到的通讯录 / 客户名单时。
# 脱敏是全局的，关掉后所有类型都不脱敏。
PII_MASKING=1

# ===== 预算守卫 =====
# 单个任务内模型调用次数上限，防止无人值守时跑飞
MAX_MODEL_CALLS=30

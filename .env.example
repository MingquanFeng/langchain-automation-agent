# ===== 模型配置 =====
# 必填：模型供应商的 API key
LLM_API_KEY=

# 模型名与供应商。provider 可选：
#   deepseek / openai / anthropic / openrouter / ollama / ...
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat

# 自定义端点（走中转/代理时填），留空则用供应商官方地址
LLM_BASE_URL=

LLM_TEMPERATURE=0.3

# ===== 运行时 =====
API_HOST=127.0.0.1
API_PORT=8000

# 定时任务总开关，0 表示只起服务不跑定时任务
SCHEDULER_ENABLED=1
SCHEDULER_TIMEZONE=Asia/Shanghai

# ===== 记忆 =====
# sqlite 落盘 / memory 仅内存
MEMORY_BACKEND=sqlite

# ===== 通知出口 =====
# terminal 只输出到终端 / webhook 发到群里
NOTIFY_CHANNEL=terminal
# 飞书/钉钉/企业微信群机器人地址，留空则只用终端
NOTIFY_WEBHOOK=

# ===== 预算守卫 =====
# 单个任务内模型调用次数上限，防止无人值守时跑飞
MAX_MODEL_CALLS=30
